# Código del demo latam360: que el navegador revalide siempre, para que los cambios
# se vean al instante (Cloudflare servía los .js con max-age de 4 h → caché vieja en móvil).
# Los assets pesados (splats, música, voz) NO se tocan aquí → mantienen su caché larga.
/latam360/app.js
  Cache-Control: no-cache, must-revalidate
/latam360/style.css
  Cache-Control: no-cache, must-revalidate
/latam360/index.html
  Cache-Control: no-cache, must-revalidate
/latam360/scenes/*
  Cache-Control: no-cache, must-revalidate
/latam360/lib/*
  Cache-Control: no-cache, must-revalidate

# Nota: Cloudflare Pages ignora Cache-Control en _headers para los assets
# (los sirve con max-age de 4 h). Para que un cambio se vea al instante hay que
# versionar el enlace en el HTML: app.js?v=AAAAMMDDx — el HTML sí revalida siempre.
